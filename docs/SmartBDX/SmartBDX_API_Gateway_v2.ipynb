   "source": [
    "import json\n",
    "from datetime import datetime\n",
    "import pandas as pd\n",
    "from smartbdx_config import DEFAULT_VOLUME_FOLDER, client\n",
    "from smartbdx_utilities import json_serialize_timestamps\n",
    "\n",
    "# Add operation parameter widgets\n",
    "dbutils.widgets.text(\"operation\", \"\", \"API Operation\")\n",
    "dbutils.widgets.text(\"parameters\", \"{}\", \"Operation Parameters JSON\")\n",
    "\n",
    "# Get operation and parameters\n",
    "operation = dbutils.widgets.get(\"operation\")\n",
    "parameters_json = dbutils.widgets.get(\"parameters\")\n",
    "\n",
    "# Parse parameters\n",
    "try:\n",
    "    parameters = json.loads(parameters_json) if parameters_json else {}\n",
    "except json.JSONDecodeError:\n",
    "    parameters = {}\n",
    "\n",
    "print(f\"🎯 Frontend API Operation: {operation}\")\n",
    "print(f\"📋 Parameters: {parameters}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Enhanced Frontend API Operation Router with Robust Batch Management\n",
    "if operation:\n",
    "    \n",
    "    if operation == \"discover_files_with_sheets\":\n",
    "        \"\"\"\n",
    "        OPTIMIZED OPERATION: Discover files AND get sheet names in one call\n",
    "        Returns: List of files with metadata including sheet names\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_selection import discover_files_and_sheets_metadata\n",
    "            \n",
    "            volume_folder = parameters.get('volume_folder', DEFAULT_VOLUME_FOLDER)\n",
    "            print(f\"🔍 Discovering files with sheets in: {volume_folder}\")\n",
    "            \n",
    "            # Use existing SmartBDX function which returns file-sheet combinations\n",
    "            metadata_df = discover_files_and_sheets_metadata(volume_folder)\n",
    "            \n",
    "            if metadata_df.empty:\n",
    "                print(\"⚠️ No files or sheets discovered\")\n",
    "                result = {\n",
    "                    \"success\": True,\n",
    "                    \"operation\": \"discover_files_with_sheets\",\n",
    "                    \"data\": [],\n",
    "                    \"total\": 0,\n",
    "                    \"timestamp\": datetime.now().isoformat()\n",
    "                }\n",
    "                dbutils.notebook.exit(json.dumps(result))\n",
    "            \n",
    "            print(f\"📊 Raw metadata: {len(metadata_df)} file-sheet combinations from SmartBDX\")\n",
    "            \n",
    "            # Group by file to collect sheet names\n",
    "            files_data = []\n",
    "            unique_files = metadata_df['file_name'].unique()\n",
    "            print(f\"📁 Processing {len(unique_files)} unique files...\")\n",
    "            \n",
    "            for file_name in unique_files:\n",
    "                file_data = metadata_df[metadata_df['file_name'] == file_name]\n",
    "                \n",
    "                # Get file-level metadata (use first row for file info)\n",
    "                first_row = file_data.iloc[0]\n",
    "                \n",
    "                # Collect all sheet names for this file\n",
    "                sheet_names = file_data['sheet_name'].tolist()\n",
    "                \n",
    "                # Clean sheet names - ensure they're strings and not empty\n",
    "                clean_sheet_names = []\n",
    "                for sheet in sheet_names:\n",
    "                    if pd.notna(sheet) and str(sheet).strip():\n",
    "                        clean_name = str(sheet).strip()\n",
    "                        clean_sheet_names.append(clean_name)\n",
    "                \n",
    "                if not clean_sheet_names:\n",
    "                    print(f\"   ⚠️ No valid sheets found for {file_name} - skipping file\")\n",
    "                    continue\n",
    "                \n",
    "                # Create frontend-compatible file object\n",
    "                file_obj = {\n",
    "                    \"id\": file_name,\n",
    "                    \"name\": file_name,\n",
    "                    \"status\": first_row.get('processing_status', 'ready'),\n",
    "                    \"lastModified\": first_row.get('last_modified', ''),\n",
    "                    \"size\": int(first_row.get('file_size_mb', 0) * 1024 * 1024) if first_row.get('file_size_mb') else 0,\n",
    "                    \"path\": first_row.get('file_path', ''),\n",
    "                    \"sheets\": clean_sheet_names,\n",
    "                    \"priority_score\": first_row.get('priority_score', 50.0),\n",
    "                    \"estimated_rows\": first_row.get('estimated_rows', 0)\n",
    "                }\n",
    "                \n",
    "                files_data.append(file_obj)\n",
    "                print(f\"   ✅ {file_name}: {len(clean_sheet_names)} sheets\")\n",
    "            \n",
    "            result = {\n",
    "                \"success\": True,\n",
    "                \"operation\": \"discover_files_with_sheets\",\n",
    "                \"data\": files_data,\n",
    "                \"total\": len(files_data),\n",
    "                \"summary\": {\n",
    "                    \"total_files\": len(files_data),\n",
    "                    \"total_sheets\": sum(len(f['sheets']) for f in files_data),\n",
    "                    \"status_breakdown\": metadata_df['processing_status'].value_counts().to_dict()\n",
    "                },\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Found {len(files_data)} files with sheet metadata\")\n",
    "            \n",
    "            # Apply timestamp serialization before JSON conversion\n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"discover_files_with_sheets\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "    \n",
    "    elif operation == \"check_processing_status\":\n",
    "        \"\"\"\n",
    "        CHECK which files need processing vs already cached\n",
    "        This runs BEFORE actual processing to show what will/won't call OpenAI\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_selection import discover_files_and_sheets_metadata\n",
    "            from smartbdx_utilities import extract_base_file_name, compute_structure_signature_from_headers\n",
    "            from smartbdx_mapping_data import load_metadata_from_cache\n",
    "            \n",
    "            volume_folder = parameters.get('volume_folder', DEFAULT_VOLUME_FOLDER)\n",
    "            selected_files = parameters.get('files', [])\n",
    "            \n",
    "            print(f\"🔍 Checking processing status for files...\")\n",
    "            \n",
    "            # Convert frontend selection to file/sheet list\n",
    "            if selected_files:\n",
    "                selected_items = []\n",
    "                for file_info in selected_files:\n",
    "                    file_id = file_info['fileId']\n",
    "                    sheets = file_info['sheets']\n",
    "                    for sheet in sheets:\n",
    "                        selected_items.append((file_id, sheet))\n",
    "            else:\n",
    "                # Check all files if no selection\n",
    "                metadata_df = discover_files_and_sheets_metadata(volume_folder)\n",
    "                selected_items = list(zip(metadata_df['file_name'], metadata_df['sheet_name']))\n",
    "            \n",
    "            print(f\"📋 Checking {len(selected_items)} file/sheet combinations...\")\n",
    "            \n",
    "            # Load only selected files to check their structure\n",
    "            unique_files = list(set([item[0] for item in selected_items]))\n",
    "            print(f\"📂 Loading {len(unique_files)} files for structure analysis...\")\n",
    "            \n",
    "            all_sheets = {}\n",
    "            for file_name in unique_files:\n",
    "                try:\n",
    "                    if dbutils is not None:\n",
    "                        file_path = f\"{volume_folder}/{file_name}\" if not volume_folder.endswith('/') else f\"{volume_folder}{file_name}\"\n",
    "                        from smartbdx_utilities import copy_volume_file_to_tmp_via_spark\n",
    "                        local_path = copy_volume_file_to_tmp_via_spark(file_path)\n",
    "                        xls = pd.ExcelFile(local_path)\n",
    "                        \n",
    "                        file_sheets = {}\n",
    "                        for sheet_name in [item[1] for item in selected_items if item[0] == file_name]:\n",
    "                            if sheet_name in xls.sheet_names:\n",
    "                                df = pd.read_excel(xls, sheet_name=sheet_name, header=None)\n",
    "                                if not df.empty:\n",
    "                                    df = df.applymap(lambda x: str(x).strip().replace(\"\\n\", \" \").replace(\"\\r\", \" \") if pd.notna(x) else None)\n",
    "                                file_sheets[sheet_name] = df\n",
    "                        \n",
    "                        all_sheets[file_name] = file_sheets\n",
    "                        xls.close()\n",
    "                        \n",
    "                        # Clean up\n",
    "                        import os\n",
    "                        try:\n",
    "                            os.remove(local_path)\n",
    "                        except:\n",
    "                            pass\n",
    "                            \n",
    "                except Exception as e:\n",
    "                    print(f\"⚠️ Could not load {file_name}: {e}\")\n",
    "            \n",
    "            # Check cache status for each file/sheet\n",
    "            processing_status = []\n",
    "            total_cached = 0\n",
    "            total_needs_ai = 0\n",
    "            \n",
    "            for file_name, sheet_name in selected_items:\n",
    "                if file_name not in all_sheets or sheet_name not in all_sheets[file_name]:\n",
    "                    processing_status.append({\n",
    "                        \"file_name\": file_name,\n",
    "                        \"sheet_name\": sheet_name,\n",
    "                        \"status\": \"error\",\n",
    "                        \"cache_hit\": False,\n",
    "                        \"needs_ai_processing\": False,\n",
    "                        \"error\": \"Could not load file/sheet\",\n",
    "                        \"structure_signature\": None,\n",
    "                        \"estimated_tokens\": 0\n",
    "                    })\n",
    "                    continue\n",
    "                \n",
    "                df = all_sheets[file_name][sheet_name]\n",
    "                base_file_name = extract_base_file_name(file_name)\n",
    "                \n",
    "                try:\n",
    "                    # Quick structure analysis to generate signature\n",
    "                    # Use first few rows as header sample for signature\n",
    "                    sample_rows = min(5, len(df))\n",
    "                    header_rows = [df.iloc[i].tolist() for i in range(sample_rows)]\n",
    "                    n_cols = df.shape[1]\n",
    "                    \n",
    "                    structure_signature = compute_structure_signature_from_headers(header_rows, n_cols)\n",
    "                    \n",
    "                    # Check if we have cached results\n",
    "                    cached = load_metadata_from_cache(base_file_name, sheet_name, structure_signature)\n",
    "                    \n",
    "                    # Estimate tokens if processing needed\n",
    "                    if not cached:\n",
    "                        from smartbdx_utilities import conservative_token_estimation\n",
    "                        estimated_tokens = conservative_token_estimation(df)\n",
    "                        total_needs_ai += 1\n",
    "                    else:\n",
    "                        estimated_tokens = 0\n",
    "                        total_cached += 1\n",
    "                    \n",
    "                    processing_status.append({\n",
    "                        \"file_name\": file_name,\n",
    "                        \"sheet_name\": sheet_name,\n",
    "                        \"status\": \"cached\" if cached else \"needs_processing\",\n",
    "                        \"cache_hit\": bool(cached),\n",
    "                        \"needs_ai_processing\": not bool(cached),\n",
    "                        \"structure_signature\": structure_signature[:12],  # First 12 chars for display\n",
    "                        \"base_file_name\": base_file_name,\n",
    "                        \"estimated_tokens\": estimated_tokens,\n",
    "                        \"rows\": len(df),\n",
    "                        \"columns\": len(df.columns),\n",
    "                        \"cache_details\": {\n",
    "                            \"found_in_cache\": bool(cached),\n",
    "                            \"will_reuse_ai_results\": bool(cached),\n",
    "                            \"will_call_openai\": not bool(cached)\n",
    "                        }\n",
    "                    })\n",
    "                    \n",
    "                except Exception as e:\n",
    "                    processing_status.append({\n",
    "                        \"file_name\": file_name,\n",
    "                        \"sheet_name\": sheet_name,\n",
    "                        \"status\": \"error\",\n",
    "                        \"cache_hit\": False,\n",
    "                        \"needs_ai_processing\": False,\n",
    "                        \"error\": str(e),\n",
    "                        \"structure_signature\": None,\n",
    "                        \"estimated_tokens\": 0\n",
    "                    })\n",
    "            \n",
    "            # Calculate totals\n",
    "            total_tokens_needed = sum([item['estimated_tokens'] for item in processing_status])\n",
    "            \n",
    "            result = {\n",
    "                \"success\": True,\n",
    "                \"operation\": \"check_processing_status\",\n",
    "                \"data\": {\n",
    "                    \"items\": processing_status,\n",
    "                    \"summary\": {\n",
    "                        \"total_items\": len(processing_status),\n",
    "                        \"cached_items\": total_cached,\n",
    "                        \"needs_ai_processing\": total_needs_ai,\n",
    "                        \"cache_hit_rate\": f\"{(total_cached/len(processing_status)*100):.1f}%\" if processing_status else \"0%\",\n",
    "                        \"estimated_total_tokens\": total_tokens_needed,\n",
    "                        \"estimated_openai_calls\": total_needs_ai,\n",
    "                        \"will_save_costs\": total_cached > 0,\n",
    "                        \"processing_efficiency\": {\n",
    "                            \"items_skip_ai\": total_cached,\n",
    "                            \"items_need_ai\": total_needs_ai,\n",
    "                            \"token_savings\": f\"{total_cached * 5000:,}\" if total_cached > 0 else \"0\"\n",
    "                        }\n",
    "                    },\n",
    "                    \"recommendations\": {\n",
    "                        \"proceed_with_processing\": total_needs_ai > 0,\n",
    "                        \"cache_benefits\": total_cached > 0,\n",
    "                        \"estimated_processing_time_minutes\": (total_needs_ai * 0.5) if total_needs_ai > 0 else 0\n",
    "                    }\n",
    "                },\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Processing status check complete:\")\n",
    "            print(f\"   📊 Total items: {len(processing_status)}\")\n",
    "            print(f\"   ✅ Cached (skip AI): {total_cached}\")\n",
    "            print(f\"   🤖 Need AI processing: {total_needs_ai}\")\n",
    "            print(f\"   💰 Estimated tokens needed: {total_tokens_needed:,}\")\n",
    "            \n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"check_processing_status\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "\n",
    "    elif operation == \"process_files\":\n",
    "        \"\"\"\n",
    "        ENHANCED BATCH PROCESSING with full production infrastructure\n",
    "        Uses robust batch orchestration with checkpointing, rate limiting, and monitoring\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_processing import azure_optimized_batch_orchestration\n",
    "            \n",
    "            selected_files = parameters.get('files', [])\n",
    "            enable_mapping = parameters.get('enable_mapping', False)\n",
    "            batch_id = parameters.get('batch_id')\n",
    "            resume_batch = parameters.get('resume_batch', False)\n",
    "            volume_folder = parameters.get('volume_folder', DEFAULT_VOLUME_FOLDER)\n",
    "            \n",
    "            if not selected_files and not resume_batch:\n",
    "                raise ValueError(\"files parameter required for new batch\")\n",
    "            \n",
    "            print(f\"🚀 Enhanced batch processing:\")\n",
    "            print(f\"   Selected files: {len(selected_files) if selected_files else 'resuming batch'}\")\n",
    "            print(f\"   Mapping enabled: {enable_mapping}\")\n",
    "            print(f\"   Resume mode: {resume_batch}\")\n",
    "            \n",
    "            if resume_batch:\n",
    "                # Resume existing batch\n",
    "                from smartbdx_processing import resume_failed_batch\n",
    "                result_data = resume_failed_batch(client, batch_id)\n",
    "                \n",
    "                result = {\n",
    "                    \"success\": True,\n",
    "                    \"operation\": \"process_files\",\n",
    "                    \"data\": {\n",
    "                        \"batch_id\": result_data.get('batch_id'),\n",
    "                        \"status\": \"resumed\",\n",
    "                        \"mode\": \"resume_failed_batch\",\n",
    "                        \"infrastructure_features\": {\n",
    "                            \"checkpoint_recovery\": True,\n",
    "                            \"rate_limiting\": True,\n",
    "                            \"error_handling\": True,\n",
    "                            \"progress_monitoring\": True\n",
    "                        },\n",
    "                        **result_data\n",
    "                    },\n",
    "                    \"timestamp\": datetime.now().isoformat()\n",
    "                }\n",
    "                \n",
    "            else:\n",
    "                # Convert frontend format to SmartBDX selection format\n",
    "                selected_items = []\n",
    "                for file_info in selected_files:\n",
    "                    file_id = file_info['fileId']\n",
    "                    sheets = file_info['sheets']\n",
    "                    for sheet in sheets:\n",
    "                        selected_items.append((file_id, sheet))\n",
    "                \n",
    "                print(f\"📋 Total file/sheet combinations: {len(selected_items)}\")\n",
    "                \n",
    "                # Use FULL production batch orchestrator\n",
    "                result_data = azure_optimized_batch_orchestration(\n",
    "                    client=client,\n",
    "                    batch_id=batch_id,\n",
    "                    resume_batch=False,\n",
    "                    tokens_per_minute=50000,\n",
    "                    requests_per_minute=50,\n",
    "                    volume_folder=volume_folder,\n",
    "                    enable_mapping=enable_mapping\n",
    "                )\n",
    "                \n",
    "                # Enhanced response with full batch metadata\n",
    "                result = {\n",
    "                    \"success\": True,\n",
    "                    \"operation\": \"process_files\",\n",
    "                    \"data\": {\n",
    "                        \"batch_id\": result_data.get('batch_id'),\n",
    "                        \"status\": result_data.get('status', 'submitted'),\n",
    "                        \"files_count\": len(selected_files),\n",
    "                        \"total_items\": len(selected_items),\n",
    "                        \"mapping_enabled\": enable_mapping,\n",
    "                        \"submitted_at\": datetime.now().isoformat(),\n",
    "                        \"infrastructure_features\": {\n",
    "                            \"checkpoint_enabled\": True,\n",
    "                            \"resume_capability\": True,\n",
    "                            \"rate_limiting\": True,\n",
    "                            \"azure_optimized\": True,\n",
    "                            \"error_recovery\": True,\n",
    "                            \"progress_monitoring\": True\n",
    "                        },\n",
    "                        \"performance_metrics\": {\n",
    "                            \"total_sheets\": result_data.get('total_sheets'),\n",
    "                            \"files_processed\": result_data.get('files_processed'),\n",
    "                            \"processing_rate\": result_data.get('average_rate_sheets_per_hour')\n",
    "                        }\n",
    "                    },\n",
    "                    \"timestamp\": datetime.now().isoformat()\n",
    "                }\n",
    "            \n",
    "            print(f\"✅ Batch operation complete: {result_data.get('batch_id')}\")\n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"process_files\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "    \n",
    "    elif operation == \"get_batch_status\":\n",
    "        \"\"\"\n",
    "        ENHANCED BATCH STATUS with comprehensive monitoring\n",
    "        Uses robust monitoring system with real-time progress tracking\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_monitoring import show_batch_progress\n",
    "            \n",
    "            batch_id = parameters.get('batch_id')\n",
    "            if not batch_id:\n",
    "                raise ValueError(\"batch_id parameter required\")\n",
    "            \n",
    "            print(f\"📊 Getting enhanced status for batch: {batch_id}\")\n",
    "            \n",
    "            # Use robust monitoring function with API mode\n",
    "            batch_info = show_batch_progress(batch_id, return_data=True)\n",
    "            \n",
    "            if not batch_info or batch_info.get('status') == 'not_found':\n",
    "                result = {\n",
    "                    \"success\": False,\n",
    "                    \"operation\": \"get_batch_status\",\n",
    "                    \"error\": f\"Batch {batch_id} not found\",\n",
    "                    \"timestamp\": datetime.now().isoformat()\n",
    "                }\n",
    "                dbutils.notebook.exit(json.dumps(result))\n",
    "            \n",
    "            result = {\n",
    "                \"success\": True,\n",
    "                \"operation\": \"get_batch_status\",\n",
    "                \"data\": {\n",
    "                    \"batch_id\": batch_id,\n",
    "                    \"status\": batch_info.get('status'),\n",
    "                    \"progress\": batch_info.get('progress', 0),\n",
    "                    \"completed_files\": batch_info.get('completed', 0),\n",
    "                    \"total_files\": batch_info.get('total', 0),\n",
    "                    \"errors\": batch_info.get('errors', 0),\n",
    "                    \"pending\": batch_info.get('pending', 0),\n",
    "                    \"processing\": batch_info.get('processing', 0),\n",
    "                    \"current_file\": batch_info.get('current_file'),\n",
    "                    \"elapsed_time_minutes\": batch_info.get('elapsed_time_minutes'),\n",
    "                    \"estimated_remaining_minutes\": batch_info.get('estimated_remaining_minutes'),\n",
    "                    \"start_time\": batch_info.get('start_time'),\n",
    "                    \"last_updated\": batch_info.get('last_updated'),\n",
    "                    \"capabilities\": {\n",
    "                        \"checkpoint_data_available\": True,\n",
    "                        \"resume_capability\": batch_info.get('status') in ['failed', 'processing'],\n",
    "                        \"rate_limit_compliance\": True,\n",
    "                        \"detailed_monitoring\": True\n",
    "                    },\n",
    "                    \"error_details\": batch_info.get('error_message') if batch_info.get('errors', 0) > 0 else None\n",
    "                },\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Status retrieved for batch: {batch_id}\")\n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"get_batch_status\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "\n",
    "    elif operation == \"smart_file_selection\":\n",
    "        \"\"\"\n",
    "        INTELLIGENT FILE SELECTION using existing SmartBDX selection logic\n",
    "        Returns optimized file selection with reasoning\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_selection import discover_files_and_sheets_metadata, select_by_criteria\n",
    "            \n",
    "            criteria = parameters.get('criteria', 'failed_first')\n",
    "            max_items = parameters.get('max_items', 25)\n",
    "            filters = parameters.get('filters', {})\n",
    "            volume_folder = parameters.get('volume_folder', DEFAULT_VOLUME_FOLDER)\n",
    "            \n",
    "            print(f\"🧠 Smart file selection with criteria: {criteria}\")\n",
    "            \n",
    "            # Use existing discovery\n",
    "            metadata_df = discover_files_and_sheets_metadata(volume_folder)\n",
    "            \n",
    "            if metadata_df.empty:\n",
    "                result = {\n",
    "                    \"success\": True,\n",
    "                    \"operation\": \"smart_file_selection\",\n",
    "                    \"data\": {\n",
    "                        \"selected_items\": [],\n",
    "                        \"message\": \"No files found for selection\"\n",
    "                    },\n",
    "                    \"timestamp\": datetime.now().isoformat()\n",
    "                }\n",
    "                dbutils.notebook.exit(json.dumps(result))\n",
    "            \n",
    "            # Use existing smart selection\n",
    "            selected_items = select_by_criteria(\n",
    "                metadata_df, \n",
    "                priority=criteria, \n",
    "                max_items=max_items,\n",
    "                exclude_completed=filters.get('exclude_completed', True),\n",
    "                min_priority_score=filters.get('min_priority_score', 50.0)\n",
    "            )\n",
    "            \n",
    "            # Enhanced analysis using existing data\n",
    "            priority_distribution = metadata_df['processing_status'].value_counts().to_dict()\n",
    "            \n",
    "            # Calculate estimates\n",
    "            estimated_processing_time = len(selected_items) * 0.5  # 30 seconds per item average\n",
    "            total_estimated_tokens = sum([\n",
    "                int(metadata_df[\n",
    "                    (metadata_df['file_name'] == item[0]) & \n",
    "                    (metadata_df['sheet_name'] == item[1])\n",
    "                ]['estimated_rows'].iloc[0] * 10) if not metadata_df[\n",
    "                    (metadata_df['file_name'] == item[0]) & \n",
    "                    (metadata_df['sheet_name'] == item[1])\n",
    "                ].empty else 1000\n",
    "                for item in selected_items\n",
    "            ])\n",
    "            \n",
    "            # Cache efficiency estimation\n",
    "            completed_items = len([\n",
    "                item for item in selected_items \n",
    "                if not metadata_df[\n",
    "                    (metadata_df['file_name'] == item[0]) & \n",
    "                    (metadata_df['sheet_name'] == item[1]) &\n",
    "                    (metadata_df['processing_status'] == 'completed')\n",
    "                ].empty\n",
    "            ])\n",
    "            \n",
    "            analysis = {\n",
    "                \"selection_reasoning\": f\"Selected based on '{criteria}' strategy prioritizing {criteria.replace('_', ' ')}\",\n",
    "                \"priority_distribution\": priority_distribution,\n",
    "                \"estimated_processing_time_minutes\": round(estimated_processing_time, 1),\n",
    "                \"estimated_token_usage\": total_estimated_tokens,\n",
    "                \"cache_efficiency\": f\"{completed_items}/{len(selected_items)} items likely already processed\",\n",
    "                \"file_diversity\": {\n",
    "                    \"unique_files\": len(set([item[0] for item in selected_items])),\n",
    "                    \"total_sheets\": len(selected_items),\n",
    "                    \"avg_sheets_per_file\": len(selected_items) / len(set([item[0] for item in selected_items])) if selected_items else 0\n",
    "                }\n",
    "            }\n",
    "            \n",
    "            # Generate recommendations\n",
    "            recommendations = {\n",
    "                \"proceed\": len(selected_items) > 0,\n",
    "                \"batch_strategy\": \"small_batches\" if len(selected_items) > 50 else \"single_batch\",\n",
    "                \"suggested_chunk_size\": min(25, len(selected_items)),\n",
    "                \"enable_mapping\": len(selected_items) < 10,  # Enable for small batches\n",
    "                \"estimated_duration\": f\"{estimated_processing_time:.0f}-{estimated_processing_time*1.5:.0f} minutes\"\n",
    "            }\n",
    "            \n",
    "            # Convert selected items to frontend format\n",
    "            frontend_selection = []\n",
    "            for file_name, sheet_name in selected_items:\n",
    "                file_data = metadata_df[\n",
    "                    (metadata_df['file_name'] == file_name) & \n",
    "                    (metadata_df['sheet_name'] == sheet_name)\n",
    "                ]\n",
    "                if not file_data.empty:\n",
    "                    row = file_data.iloc[0]\n",
    "                    frontend_selection.append({\n",
    "                        \"fileId\": file_name,\n",
    "                        \"fileName\": file_name,\n",
    "                        \"sheetName\": sheet_name,\n",
    "                        \"status\": row['processing_status'],\n",
    "                        \"priorityScore\": row['priority_score'],\n",
    "                        \"estimatedRows\": row['estimated_rows'],\n",
    "                        \"lastModified\": row['last_modified'],\n",
    "                        \"reason\": f\"Selected by {criteria} criteria\"\n",
    "                    })\n",
    "            \n",
    "            result = {\n",
    "                \"success\": True,\n",
    "                \"operation\": \"smart_file_selection\",\n",
    "                \"data\": {\n",
    "                    \"selected_items\": frontend_selection,\n",
    "                    \"selection_summary\": {\n",
    "                        \"total_selected\": len(selected_items),\n",
    "                        \"selection_criteria\": criteria,\n",
    "                        \"filters_applied\": filters\n",
    "                    },\n",
    "                    \"selection_analysis\": analysis,\n",
    "                    \"recommendations\": recommendations,\n",
    "                    \"batch_ready\": {\n",
    "                        \"files\": [{\"fileId\": item[0], \"sheets\": [item[1]]} for item in selected_items]\n",
    "                    }\n",
    "                },\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Smart selection complete: {len(selected_items)} items selected\")\n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"smart_file_selection\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "\n",
    "    elif operation == \"get_cache_analytics\":\n",
    "        \"\"\"\n",
    "        CACHE PERFORMANCE ANALYTICS using existing cache infrastructure\n",
    "        \"\"\"\n",
    "        try:\n",
    "            print(\"📊 Analyzing cache performance and efficiency...\")\n",
    "            \n",
    "            # Query existing cache tables\n",
    "            try:\n",
    "                cache_query = \"\"\"\n",
    "                SELECT \n",
    "                    COUNT(*) as total_cached_items,\n",
    "                    COUNT(DISTINCT base_file_name) as unique_file_patterns,\n",
    "                    COUNT(DISTINCT structure_signature) as unique_structures,\n",
    "                    AVG(DATEDIFF(HOUR, processed_at, current_timestamp())) as avg_cache_age_hours\n",
    "                FROM bdx.metadata_cache.structure_metadata_cache\n",
    "                WHERE processed_at >= current_timestamp() - INTERVAL 30 DAYS\n",
    "                \"\"\"\n",
    "                \n",
    "                cache_stats_result = spark.sql(cache_query).collect()\n",
    "                \n",
    "                if cache_stats_result:\n",
    "                    cache_stats = cache_stats_result[0]\n",
    "                    total_cached = cache_stats.total_cached_items or 0\n",
    "                    unique_patterns = cache_stats.unique_file_patterns or 0\n",
    "                    unique_structures = cache_stats.unique_structures or 0\n",
    "                    avg_age_hours = cache_stats.avg_cache_age_hours or 0\n",
    "                else:\n",
    "                    total_cached = unique_patterns = unique_structures = avg_age_hours = 0\n",
    "                    \n",
    "            except Exception as e:\n",
    "                print(f\"⚠️ Cache table query failed: {e}\")\n",
    "                total_cached = unique_patterns = unique_structures = avg_age_hours = 0\n",
    "            \n",
    "            # Analyze processing efficiency from checkpoint data\n",
    "            try:\n",
    "                efficiency_query = \"\"\"\n",
    "                SELECT \n",
    "                    status,\n",
    "                    COUNT(*) as count,\n",
    "                    AVG(DATEDIFF(MINUTE, started_at, completed_at)) as avg_processing_time_minutes\n",
    "                FROM bdx.metadata_cache.batch_checkpoints\n",
    "                WHERE started_at >= current_timestamp() - INTERVAL 7 DAYS\n",
    "                GROUP BY status\n",
    "                \"\"\"\n",
    "                \n",
    "                efficiency_results = spark.sql(efficiency_query).collect()\n",
    "                status_breakdown = {row.status: {\"count\": row.count, \"avg_time\": row.avg_processing_time_minutes or 0} for row in efficiency_results}\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"⚠️ Efficiency query failed: {e}\")\n",
    "                status_breakdown = {}\n",
    "            \n",
    "            # Calculate cache efficiency metrics\n",
    "            total_processed = sum([data[\"count\"] for data in status_breakdown.values()])\n",
    "            completed_count = status_breakdown.get(\"completed\", {}).get(\"count\", 0)\n",
    "            \n",
    "            # Estimate savings\n",
    "            estimated_token_savings = total_cached * 5000  # Rough estimate: 5k tokens saved per cached structure\n",
    "            estimated_cost_savings = total_cached * 0.025  # Rough estimate: $0.025 saved per cached item\n",
    "            \n",
    "            # Cache health assessment\n",
    "            cache_health = \"excellent\" if total_cached > 100 else \"good\" if total_cached > 20 else \"building\"\n",
    "            \n",
    "            # Generate optimization recommendations\n",
    "            recommendations = []\n",
    "            if unique_structures < unique_patterns * 0.5:\n",
    "                recommendations.append(\"High structure reuse detected - cache is very effective\")\n",
    "            if avg_age_hours > 168:  # 1 week\n",
    "                recommendations.append(\"Some cache entries are old - consider cleanup\")\n",
    "            if total_cached < 10:\n",
    "                recommendations.append(\"Cache is still building - process more files to improve efficiency\")\n",
    "            \n",
    "            result = {\n",
    "                \"success\": True,\n",
    "                \"operation\": \"get_cache_analytics\",\n",
    "                \"data\": {\n",
    "                    \"cache_statistics\": {\n",
    "                        \"total_cached_structures\": total_cached,\n",
    "                        \"unique_file_patterns\": unique_patterns,\n",
    "                        \"unique_table_structures\": unique_structures,\n",
    "                        \"average_cache_age_hours\": round(avg_age_hours, 1),\n",
    "                        \"structure_reuse_ratio\": round(total_cached / max(unique_structures, 1), 2)\n",
    "                    },\n",
    "                    \"processing_efficiency\": {\n",
    "                        \"status_breakdown\": status_breakdown,\n",
    "                        \"total_items_processed\": total_processed,\n",
    "                        \"completion_rate\": f\"{(completed_count/max(total_processed,1)*100):.1f}%\",\n",
    "                        \"cache_hit_benefit\": {\n",
    "                            \"estimated_token_savings\": estimated_token_savings,\n",
    "                            \"estimated_cost_savings_usd\": round(estimated_cost_savings, 2),\n",
    "                            \"processing_time_saved_hours\": round(total_cached * 0.5 / 60, 1)  # Est 30 sec saved per cache hit\n",
    "                        }\n",
    "                    },\n",
    "                    \"cache_health\": {\n",
    "                        \"overall_rating\": cache_health,\n",
    "                        \"effectiveness_score\": min(100, (total_cached / max(unique_structures, 1)) * 20),\n",
    "                        \"recommendations\": recommendations\n",
    "                    },\n",
    "                    \"optimization_opportunities\": {\n",
    "                        \"high_reuse_patterns\": f\"{unique_patterns} file patterns with {unique_structures} unique structures\",\n",
    "                        \"potential_template_candidates\": max(0, unique_patterns - unique_structures),\n",
    "                        \"cache_growth_trend\": \"positive\" if total_cached > 0 else \"starting\"\n",
    "                    }\n",
    "                },\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Cache analytics complete: {total_cached} cached items analyzed\")\n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"get_cache_analytics\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "\n",
    "    elif operation == \"get_processing_insights\":\n",
    "        \"\"\"\n",
    "        COMPREHENSIVE PROCESSING INSIGHTS using existing monitoring data\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_monitoring import show_batch_progress\n",
    "            \n",
    "            batch_id = parameters.get('batch_id')\n",
    "            include_predictions = parameters.get('include_predictions', True)\n",
    "            include_analysis = parameters.get('include_analysis', True)\n",
    "            \n",
    "            if not batch_id:\n",
    "                raise ValueError(\"batch_id parameter required\")\n",
    "            \n",
    "            print(f\"📊 Getting comprehensive insights for batch: {batch_id}\")\n",
    "            \n",
    "            # Get existing batch data\n",
    "            batch_data = show_batch_progress(batch_id, return_data=True)\n",
    "            \n",
    "            if not batch_data or batch_data.get('status') == 'not_found':\n",
    "                result = {\n",
    "                    \"success\": False,\n",
    "                    \"operation\": \"get_processing_insights\",\n",
    "                    \"error\": f\"Batch {batch_id} not found\",\n",
    "                    \"timestamp\": datetime.now().isoformat()\n",
    "                }\n",
    "                dbutils.notebook.exit(json.dumps(result))\n",
    "            \n",
    "            # Enhanced analysis using existing data\n",
    "            insights = {}\n",
    "            \n",
    "            if include_predictions and batch_data:\n",
    "                # Calculate processing velocity and predictions\n",
    "                completed = batch_data.get('completed', 0)\n",
    "                total = batch_data.get('total', 1)\n",
    "                errors = batch_data.get('errors', 0)\n",
    "                pending = batch_data.get('pending', 0)\n",
    "                processing = batch_data.get('processing', 0)\n",
    "                elapsed_minutes = batch_data.get('elapsed_time_minutes', 1)\n",
    "                \n",
    "                # Processing metrics\n",
    "                processing_rate = completed / elapsed_minutes if elapsed_minutes > 0 else 0\n",
    "                success_rate = completed / total if total > 0 else 0\n",
    "                error_rate = errors / total if total > 0 else 0\n",
    "                \n",
    "                # Predictions\n",
    "                remaining = pending + processing\n",
    "                eta_minutes = remaining / processing_rate if processing_rate > 0 else None\n",
    "                \n",
    "                # Quality assessment\n",
    "                batch_health = \"excellent\" if error_rate < 0.02 else \"good\" if error_rate < 0.05 else \"needs_attention\"\n",
    "                processing_stability = \"stable\" if processing_rate > 0.1 else \"slow\" if processing_rate > 0 else \"stalled\"\n",
    "                \n",
    "                insights[\"performance_metrics\"] = {\n",
    "                    \"processing_velocity\": round(processing_rate, 3),\n",
    "                    \"items_per_hour\": round(processing_rate * 60, 1),\n",
    "                    \"success_rate_percentage\": round(success_rate * 100, 1),\n",
    "                    \"error_rate_percentage\": round(error_rate * 100, 1),\n",
    "                    \"completion_percentage\": round((completed / total) * 100, 1),\n",
    "                    \"estimated_completion_minutes\": round(eta_minutes, 1) if eta_minutes else None\n",
    "                }\n",
    "                \n",
    "                insights[\"quality_indicators\"] = {\n",
    "                    \"batch_health\": batch_health,\n",
    "                    \"processing_stability\": processing_stability,\n",
    "                    \"error_trend\": \"improving\" if error_rate < 0.05 else \"stable\",\n",
    "                    \"performance_rating\": \"high\" if processing_rate > 1.0 else \"normal\" if processing_rate > 0.5 else \"low\"\n",
    "                }\n",
    "                \n",
    "                # Efficiency analysis\n",
    "                if elapsed_minutes > 0:\n",
    "                    tokens_per_minute_estimate = (completed * 3000) / elapsed_minutes  # Rough estimate\n",
    "                    cost_per_minute_estimate = tokens_per_minute_estimate * 0.00003  # Rough GPT-4 pricing\n",
    "                    \n",
    "                    insights[\"efficiency_analysis\"] = {\n",
    "                        \"estimated_tokens_per_minute\": round(tokens_per_minute_estimate, 0),\n",
    "                        \"estimated_cost_per_minute_usd\": round(cost_per_minute_estimate, 4),\n",
    "                        \"projected_total_cost_usd\": round(cost_per_minute_estimate * (elapsed_minutes + (eta_minutes or 0)), 2),\n",
    "                        \"resource_utilization\": \"optimal\" if 0.5 <= processing_rate <= 2.0 else \"review_recommended\"\n",
    "                    }\n",
    "            \n",
    "            if include_analysis:\n",
    "                # Historical comparison (if we have data)\n",
    "                try:\n",
    "                    historical_query = f\"\"\"\n",
    "                    SELECT \n",
    "                        AVG(DATEDIFF(MINUTE, started_at, completed_at)) as avg_duration,\n",
    "                        AVG(CASE WHEN status = 'completed' THEN 1.0 ELSE 0.0 END) as avg_success_rate,\n",
    "                        COUNT(*) as historical_batches\n",
    "                    FROM bdx.metadata_cache.batch_checkpoints\n",
    "                    WHERE started_at >= current_timestamp() - INTERVAL 30 DAYS\n",
    "                    AND batch_id != '{batch_id}'\n",
    "                    \"\"\"\n",
    "                    \n",
    "                    historical_data = spark.sql(historical_query).collect()\n",
    "                    \n",
    "                    if historical_data and historical_data[0].historical_batches > 0:\n",
    "                        hist = historical_data[0]\n",
    "                        current_duration = elapsed_minutes\n",
    "                        avg_duration = hist.avg_duration or 0\n",
    "                        \n",
    "                        insights[\"comparative_analysis\"] = {\n",
    "                            \"vs_historical_average\": {\n",
    "                                \"duration_comparison\": \"faster\" if current_duration < avg_duration * 0.8 else \"similar\" if current_duration < avg_duration * 1.2 else \"slower\",\n",
    "                                \"success_rate_comparison\": \"better\" if success_rate > (hist.avg_success_rate or 0) else \"similar\",\n",
    "                                \"historical_batches_count\": hist.historical_batches\n",
    "                            },\n",
    "                            \"performance_percentile\": \"top_25%\" if processing_rate > 1.5 else \"median\" if processing_rate > 0.75 else \"lower_quartile\"\n",
    "                        }\n",
    "                        \n",
    "                except Exception as e:\n",
    "                    print(f\"⚠️ Historical analysis failed: {e}\")\n",
    "                    insights[\"comparative_analysis\"] = {\"error\": \"Historical data unavailable\"}\n",
    "            \n",
    "            # Combine original batch data with insights\n",
    "            enhanced_batch_data = {\n",
    "                **batch_data,\n",
    "                \"processing_insights\": insights\n",
    "            }\n",
    "            \n",
    "            result = {\n",
    "                \"success\": True,\n",
    "                \"operation\": \"get_processing_insights\",\n",
    "                \"data\": enhanced_batch_data,\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Processing insights generated for batch: {batch_id}\")\n",
    "            serializable_result = json_serialize_timestamps(result)\n",
    "            dbutils.notebook.exit(json.dumps(serializable_result))\n",
    "            \n",
    "        except Exception as e:\n",
    "            error_result = {\n",
    "                \"success\": False,\n",
    "                \"operation\": \"get_processing_insights\",\n",
    "                \"error\": str(e),\n",
    "                \"timestamp\": datetime.now().isoformat()\n",
    "            }\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            dbutils.notebook.exit(json.dumps(error_result))\n",
    "\n",
    "    elif operation == \"quick_file_analysis\":\n",
    "        \"\"\"\n",
    "        QUICK FILE ANALYSIS - Preview structure without full processing\n",
    "        \"\"\"\n",
    "        try:\n",
    "            from smartbdx_selection import discover_files_and_sheets_metadata\n",
    "            from smartbdx_utilities import extract_base_file_name, copy_volume_file_to_tmp_via_spark\n",
    "            \n",
    "            file_path = parameters.get('file_path')\n",
    "            file_name = parameters.get('file_name')\n",
    "            volume_folder = parameters.get('volume_folder', DEFAULT_VOLUME_FOLDER)\n",
    "            \n",
    "            if not file_path and not file_name:\n",
    "                raise ValueError(\"Either file_path or file_name required\")\n",
    "            \n",
    "            if not file_path:\n",
    "                file_path = f\"{volume_folder}/{file_name}\" if not volume_folder.endswith('/') else f\"{volume_folder}{file_name}\"\n",
    "                file_name = file_name\n",
    "            else:\n",
    "                file_name = file_path.split('/')[-1]\n",
    "            \n",
    "            print(f\"🔍 Quick analysis for file: {file_name}\")\n",
    "            \n",
    "            # Load file for quick analysis\n",
    "            try:\n",
    "                local_path = copy_volume_file_to_tmp_via_spark(file_path)\n",
    "                xls = pd.ExcelFile(local_path)\n",
    "                \n",
    "                # Quick sheet analysis\n",
    "                sheet_analysis = []\n",
    "                for sheet_name in xls.sheet_names:\n",
    "                    try:\n",
    "                        # Load just first 100 rows for quick analysis\n",
    "                        df_sample = pd.read_excel(xls, sheet_name=sheet_name, header=None, nrows=100)\n",
    "                        \n",
    "                        # Quick complexity assessment\n",
    "                        total_rows = len(df_sample)\n",
    "                        total_cols = len(df_sample.columns)\n",
    "                        non_empty_cells = df_sample.count().sum()\n",
    "                        density = non_empty_cells / (total_rows * total_cols) if total_rows * total_cols > 0 else 0\n",
    "                        \n",
    "                        # Detect potential table regions\n",
    "                        data_rows = 0\n",
    "                        for idx, row in df_sample.iterrows():\n",
    "                            if any(str(cell).strip() for cell in row):\n",
    "                                data_rows += 1\n",
    "                        \n",
    "                        # Estimate complexity\n",
    "                        complexity = \"simple\" if total_rows < 20 and total_cols < 10 else \"moderate\" if total_rows < 50 and total_cols < 20 else \"complex\"\n",
    "                        \n",
    "                        # Estimate processing requirements\n",
    "                        estimated_tokens = total_rows * total_cols * 3  # Rough estimate\n",
    "                        estimated_time_seconds = max(30, total_rows * 0.5)  # Rough estimate\n",
    "                        \n",
    "                        sheet_analysis.append({\n",
    "                            \"sheet_name\": sheet_name,\n",
    "                            \"dimensions\": {\n",
    "                                \"rows\": total_rows,\n",
    "                                \"columns\": total_cols,\n",
    "                                \"data_density\": round(density, 2)\n",
    "                            },\n",
    "                            \"complexity_assessment\": {\n",
    "                                \"level\": complexity,\n",
    "                                \"data_rows_detected\": data_rows,\n",
    "                                \"estimated_table_regions\": max(1, data_rows // 20)\n",
